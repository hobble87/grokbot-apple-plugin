# Copy to .env (never commit it). Env vars override config.json.
APPLE_BRIDGE_CONFIG=./config.json
APPLE_BRIDGE_WEBHOOK_URL=https://your-assistant.example.com/hooks/imessage
APPLE_BRIDGE_WEBHOOK_TOKEN=replace-me
APPLE_BRIDGE_ALLOWED_CONTACTS=+447700900000,someone@example.com
APPLE_BRIDGE_CALENDAR=Assistant Shared
APPLE_BRIDGE_REMINDERS_LIST=Assistant Shared
# APPLE_BRIDGE_MESSAGES_DB=/Users/YOU/Library/Messages/chat.db
# APPLE_BRIDGE_STATE_DIR=./work
# APPLE_BRIDGE_POLL_SECONDS=3
